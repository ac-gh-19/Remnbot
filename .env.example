DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
GUILD_ID=your-test-server-id

# Postgres connection; local Postgres.app needs no password
DATABASE_URL=postgres://localhost:5432/discord_bot

# Voyage AI key for embeddings (https://dashboard.voyageai.com); only needed to embed chunks
VOYAGE_API_KEY=your-voyage-api-key

# Conversation chunking for /backfill (defaults shown)
CHUNK_MESSAGE_LIMIT=150
CHUNK_OVERLAP=20
CONVERSATION_GAP_MINUTES=45
CONVERSATION_MIN_MESSAGES=3

# Anthropic key for summarizing conversations; only needed to summarize
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model that summarizes conversations: opus, sonnet or haiku (default opus)
SUMMARY_MODEL=opus
